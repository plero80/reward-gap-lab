{
  "schema_version": 1,
  "experiment": "smoke",
  "seeds": [
    42
  ],
  "models": {
    "policy": {
      "id": "Qwen/Qwen2.5-0.5B-Instruct",
      "revision": "main"
    },
    "proxy": {
      "id": "Skywork/Skywork-Reward-V2-Qwen3-0.6B",
      "revision": "main"
    },
    "judge": {
      "id": "Skywork/Skywork-Reward-V2-Qwen3-4B",
      "revision": "main"
    }
  },
  "data": {
    "revision": "main",
    "subsets": [
      "helpful-base",
      "helpful-online",
      "helpful-rejection-sampled",
      "harmless-base"
    ],
    "split_seed": 42,
    "cache_dir": "data/raw/hh-rlhf",
    "prepared_dir": "data/prepared/hh-h200-smoke",
    "minimum_prompts": {
      "calibration": 16,
      "initial_memory": 32,
      "training": 32,
      "refresh": 16,
      "validation": 8,
      "final_evaluation": 16
    }
  },
  "training": {
    "round1_updates": 2,
    "total_updates": 4,
    "rollout_batch_size": 8,
    "learning_rate": 3e-06,
    "kl_coefficient": 0.05,
    "checkpoint_every": 1,
    "ppo_epochs": 4,
    "minibatch_size": 2
  },
  "policy": {
    "lora_rank": 8,
    "lora_alpha": 16,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "generation": {
    "max_prompt_tokens": 8192,
    "max_new_tokens": 256,
    "do_sample": true
  },
  "scoring": {
    "max_tokens": 16384,
    "batch_size": 2
  },
  "memory": {
    "k": 8,
    "temperature": 0.1
  },
  "runtime": {
    "device": "cuda:0",
    "dtype": "bfloat16",
    "output_root": "outputs",
    "model_cache": "model_cache",
    "allow_downloads": true
  }
}
